        "title": {
          "en": "The last drawer",
          "hi": "अन्तिम दराज़"
        },
        "image": {
          "id": "vc1-cur-s1",
          "brief": "A very small quick hand reaching out of an open drawer in the little spirit's body and snatching a pencil from behind his ear; the spirit squealing; the Vetāla amused; Dādī and Śuka laughing; firelight.",
          "alt": {
            "en": "A tiny hand from a drawer snatches a pencil from behind a startled spirit's ear",
            "hi": "दराज़ से निकला नन्हा हाथ चौंके भूत के कान के पीछे से पेंसिल छीनता"
          },
          "text_in_image": [],
