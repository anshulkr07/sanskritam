        "id": "s1",
        "title": {
          "en": "The doubling drawer",
          "hi": "द्वित्व वाला दराज़"
        },
        "image": {
          "id": "vc2-da-s1",
          "brief": "A small spirit emerging from an open drawer, bowing and handing an apple to you, with two more apples in its other hand; Dhātuka beside it ticking a list; Dādī laughing; Śuka eyeing an apple.",
          "alt": {
            "en": "A small spirit from a drawer bows and hands over apples while a parrot eyes one",
            "hi": "दराज़ से निकला नन्हा भूत झुककर सेब देता, तोता एक पर नज़र टिकाए"
          },
          "text_in_image": [],
