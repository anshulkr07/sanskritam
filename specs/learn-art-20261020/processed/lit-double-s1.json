            "check": null
          }
        ],
        "quote": {
          "sa": "आदित्यवर्मनामात्र बभूव नृपतिः पुरा",
          "gloss": {
            "en": "Here, long ago, there was a king named Ādityavarman.",
            "hi": "यहाँ, बहुत पहले, आदित्यवर्मा नाम का एक राजा हुआ।"
          },
          "source": "Kathāsaritsāgara 1.5 (read in the Digital Corpus of Sanskrit)"
        }
