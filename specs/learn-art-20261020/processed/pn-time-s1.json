      {
        "id": "s1",
        "title": {
          "en": "Days on the road",
          "hi": "मार्ग के दिन"
        },
        "image": {
          "id": "pn-time-s1",
          "brief": "Dādī and the knotted-cord spirit at a low table: on a clay slate a ladder of written numbers and a circle of a day cut into eight slices, half bright and half dark; Śuka looking at the slate; Dādī pointing.",
          "alt": {
            "en": "Dādī draws a day cut into eight watches on a clay slate beside the cord spirit",
            "hi": "दादी पाटी पर आठ पहरों में कटा दिन खींचती हुई, पास में डोरी का भूत"
          },
          "text_in_image": [],
