          "7.3.106"
        ],
        "kind": "teach",
        "body": {
          "en": "A feminine word in -{{आ}} has its own pattern: {{लता}} (first), {{लताम्}} (object), {{लतया}} (by), {{लतायै}} (to), {{लतायाः}} (from, of), {{लतायाम्}} (in), {{हे लते}} (call). The long {{आ}} runs through almost everything.",
          "hi": "-{{आ}} वाले स्त्रीलिंग शब्द का अपना ढाँचा है: {{लता}} (प्रथमा), {{लताम्}} (कर्म), {{लतया}} (से), {{लतायै}} (को), {{लतायाः}} (से, का), {{लतायाम्}} (में), {{हे लते}} (पुकार)। दीर्घ {{आ}} लगभग सब जगह चलता है।"
        },
        "examples": [],
        "rows": [],
        "steps": [],
        "formula": null,
        "term": {
          "sa": "आकारान्तम्",
          "meaning": {
            "en": "a word ending in -आ",
            "hi": "-आ पर समाप्त शब्द"
          }
        }
      },
