            "text": null,
            "check": null
          }
        ],
        "quote": {
          "sa": "राजन् श्रूयताम् तावत् कथाम् एकां कथयामि",
          "gloss": {
            "en": "O king, let it be heard: I tell one tale.",
            "hi": "हे राजन्, सुनिए: मैं एक कथा कहता हूँ।"
          },
          "source": "Vetālapañcaviṃśatikā, introduction (read in the Digital Corpus of Sanskrit)"
        }
