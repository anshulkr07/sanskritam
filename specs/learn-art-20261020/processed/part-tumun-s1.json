        "id": "s1",
        "title": {
          "en": "A word that wants",
          "hi": "चाहने वाला शब्द"
        },
        "image": {
          "id": "part-tumun-s1",
          "brief": "The paper-fan spirit folding his answer into a single word on one fold; Śuka testing words with a raised wing; Dādī smiling; the Vetāla listening with half-closed eyes; firelight.",
          "alt": {
            "en": "A paper-fan spirit folds an answer into one word while a parrot tests words",
            "hi": "काग़ज़ी पंखे जैसा भूत उत्तर को एक शब्द में समेटता, शब्द परखता तोता"
          },
          "text_in_image": [],
          "ratio": "4:3",
          "cast": [
            "you",
            "dadi",
            "shuka",
