# Allow only the inputs COPYed by the backend Dockerfile.
# Local app.db.bak-* files must never enter the cloud source archive.
**
!/.gcloudignore
!/.dockerignore
!/Dockerfile
!/backend/
!/backend/requirements.txt
!/backend/alembic.ini
!/backend/app/
!/backend/app/**
!/backend/migrations/
!/backend/migrations/**
!/frontend/
!/frontend/**

# Exclude generated files and credentials even inside allowed trees.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/node_modules/
**/.env*
**/*.db*
**/*credentials*.json
**/service-account-key.json
**/*.pem
**/*.key
/frontend/src/
