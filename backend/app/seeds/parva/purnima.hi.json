     "text_name": "Skanda Purana, Avantikhanda, Reva Khanda",
     "ref": "Skanda Reva 134",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=162838&prop=wikitext&format=json"
    },
