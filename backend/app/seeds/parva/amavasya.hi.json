 "body": {
  "summary": "विश्राम, दान और स्मरण का अमावस्या दिन।",
  "why": [
   {
    "text": "अमावस्या कृष्ण पक्ष की तीसवीं तिथि होती है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "परिवार इस दिन भोजन और दान देते हैं।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "महालय अमावस्या पितृपक्ष का समापन करती है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "शाम को घर में दीप जलाए जाते हैं।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "दीप, तिल और दान की वस्तुएं तैयार रखें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "steps": [
    {
     "text": "सुबह स्नान कर घर की सफाई करें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "जरूरतमंदों को भोजन और दान दें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "शाम को दीप जलाएं।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "vrat": {
   "eat": [
    {
     "text": "व्रत में फल, दूध और सिंघाड़े का आटा लें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "सेंधा नमक का प्रयोग करें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "avoid": [
    {
     "text": "अनाज, दाल, चावल और सामान्य नमक से बचें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "प्याज, लहसुन और तामसिक भोजन से बचें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "break": [
    {
     "text": "अगले दिन सूर्योदय के बाद पारण समय में व्रत खोलें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "who_should_eat": [
    {
     "text": "गर्भवती, मधुमेह रोगी, दवा लेने वाले, बीमार, बच्चे और बुजुर्ग केवल फल लें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "dont": [
   {
    "text": "इस दिन झगड़ा न करें।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
