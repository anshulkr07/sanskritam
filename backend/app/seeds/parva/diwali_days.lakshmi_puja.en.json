 "body": {
  "summary": "The new-moon night when Lakshmi rose and chose Vishnu.",
  "why": [
   {
    "text": "Lakshmi rises from the churned ocean, shining like lightning.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 8.8",
    "source_url": "https://vedabase.io/en/library/sb/8/8/"
   },
   {
    "text": "Gods, demons, and men all desire her, the source of opulence.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 8.8",
    "source_url": "https://vedabase.io/en/library/sb/8/8/"
   },
   {
    "text": "She garlands Vishnu and takes her place at his chest.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 8.8",
    "source_url": "https://vedabase.io/en/library/sb/8/8/"
   },
   {
    "text": "Unceasing effort brings Lakshmi, not fate.",
    "basis": "text",
    "text_name": "Pancatantra",
    "ref": "Pancatantra 1.217",
    "source_url": "shlokas row 11ce8c5d2aa743f3"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "Keep water, flowers, and ornaments ready for bathing.",
     "basis": "text",
     "text_name": "Bhagavata Purana",
     "ref": "Bhagavata 8.8",
     "source_url": "https://vedabase.io/en/library/sb/8/8/"
    }
   ],
   "steps": [
    {
     "text": "Welcome Lakshmi as the gods welcomed her with bathing and song.",
     "basis": "text",
     "text_name": "Bhagavata Purana",
     "ref": "Bhagavata 8.8",
     "source_url": "https://vedabase.io/en/library/sb/8/8/"
    },
    {
     "text": "Work with effort instead of waiting on fate.",
     "basis": "text",
     "text_name": "Pancatantra",
     "ref": "Pancatantra 1.217",
     "source_url": "shlokas row 11ce8c5d2aa743f3"
    }
   ],
   "budget": [
    {
     "text": "Reuse a clean cloth and the deity's picture already at home.",
     "basis": "custom",
     "region": "family",
     "source_url": "https://vedabase.io/en/library/sb/8/8/"
    },
    {
     "text": "Set aside water and a small seasonal offering from what you have.",
     "basis": "custom",
     "region": "family",
     "source_url": "https://vedabase.io/en/library/sb/8/8/"
    },
    {
     "text": "Keep the observance simple: prayer and attention, with any lamp placed safely.",
     "basis": "custom",
     "region": "family",
     "source_url": "https://vedabase.io/en/library/sb/8/8/"
    }
   ]
  },
