 "body": {
  "summary": "हर चंद्र मास में दो बार रखा जाने वाला एकादशी व्रत।",
  "why": [
   {
    "text": "युधिष्ठिर कृष्ण से चैत्र कृष्ण एकादशी का नाम और कथा पूछते हैं।",
    "basis": "text",
    "text_name": "Padma Purana, Uttarakhanda",
    "ref": "Padma 6.36",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25044&prop=wikitext&format=json"
   },
   {
    "text": "कृष्ण लोमश के माध्यम से राजा मांधाता को पापमोचनी कथा सुनाते हैं।",
    "basis": "text",
    "text_name": "Padma Purana, Uttarakhanda",
    "ref": "Padma 6.36",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25044&prop=wikitext&format=json"
   },
   {
    "text": "व्यास इस व्रत को सहज उपाय और महान फल वाला बताते हैं।",
    "basis": "text",
    "text_name": "Padma Purana, Uttarakhanda",
    "ref": "Padma 6.351",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=44623&prop=wikitext&format=json"
   },
   {
    "text": "स्वर्ग के लिए यह व्रत जीवन भर रखें।",
    "basis": "text",
    "text_name": "Padma Purana, Uttarakhanda",
    "ref": "Padma 6.351",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=44623&prop=wikitext&format=json"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "फूल, धूप और दीप तैयार रखें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    }
   ],
   "steps": [
    {
     "text": "सुबह स्नान कर व्रत का संकल्प लें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    },
    {
     "text": "फूल और धूप से विष्णु की पूजा करें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    },
    {
     "text": "शाम को दीप जलाएं।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    },
    {
     "text": "पूजा के बाद द्वादशी की सुबह भोजन करें।",
     "basis": "text",
     "text_name": "Padma Purana, Uttarakhanda",
     "ref": "Padma 6.351",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=44623&prop=wikitext&format=json"
    }
   ],
   "budget": [
    {
     "text": "घर में उपलब्ध साफ चौकी या कपड़ा और देवता का चित्र उपयोग करें।",
     "basis": "custom",
     "region": "family",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25044&prop=wikitext&format=json"
    },
    {
     "text": "पानी, थोड़ा चावल और उपलब्ध मौसमी फल लें; महंगे उपहार आवश्यक नहीं।",
     "basis": "custom",
     "region": "family",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25044&prop=wikitext&format=json"
    },
    {
     "text": "अपने परिवार की परम्परा के अनुसार सरल प्रार्थना करें; सुरक्षित स्थान पर दीपक रखें।",
     "basis": "custom",
     "region": "family",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25044&prop=wikitext&format=json"
    }
   ]
  },
