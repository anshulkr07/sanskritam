 "body": {
  "summary": "Full moon ending the five-day Bhishma vow.",
  "why": [
   {
    "text": "On Ekadashi one takes up a five-day vow ending on full moon.",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   },
   {
    "text": "Bhishma keeps it with bathing, tarpana, gifts, and lamps.",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   },
   {
    "text": "Lamps are offered day and night.",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   },
   {
    "text": "On Purnima day worship, feed brahmanas, and break the fast.",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   }
