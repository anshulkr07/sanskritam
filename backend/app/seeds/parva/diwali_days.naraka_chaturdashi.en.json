 "body": {
  "summary": "The day Krishna killed Narakasura and freed the captives.",
  "why": [
   {
    "text": "Indra complains to Krishna about Narakasura's thefts.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 10.59",
    "source_url": "https://vedabase.io/en/library/sb/10/59/"
   },
   {
    "text": "Krishna and Satyabhama ride Garuda to Pragjyotisha.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 10.59",
    "source_url": "https://vedabase.io/en/library/sb/10/59/"
   },
   {
    "text": "Krishna slays Mura, his sons, and then Naraka with the disc.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 10.59",
    "source_url": "https://vedabase.io/en/library/sb/10/59/"
   },
   {
    "text": "Sixteen thousand captives are freed and Aditi's earrings returned.",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 10.59",
    "source_url": "https://vedabase.io/en/library/sb/10/59/"
   },
   {
    "text": "When dharma declines, Vishnu projects himself forth.",
    "basis": "text",
    "text_name": "Bhagavad Gita",
    "ref": "Gita 4.7",
    "source_url": "shlokas row 744d5388ec4b4cf7"
   }
  ],
  "do": {
