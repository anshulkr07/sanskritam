 "body": {
  "summary": "Twice a month fast on the eleventh tithi.",
  "why": [
   {
    "text": "Ekadashi is the eleventh tithi of each half month.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "Observers fast from sunrise to next morning.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "The fast is broken in the parana window.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "Each Ekadashi has its own name and story.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "Clean the home altar in the morning.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "steps": [
    {
     "text": "Bathe and resolve to keep the fast.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Offer water and flowers to Vishnu.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Read the Ekadashi story of the day.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Stay awake for some time at night.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Break the fast in the parana window.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "vrat": {
   "eat": [
    {
     "text": "Take fruit, milk and water chestnut flour on the fast.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Use rock salt in fast cooking.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "avoid": [
    {
     "text": "Avoid grains, lentils, rice and common salt.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Avoid onion, garlic and heavy food.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "break": [
    {
     "text": "Break the fast next morning in the parana window.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "who_should_eat": [
    {
     "text": "People who are pregnant, diabetic, on regular medicines, ill, children and the elderly take only fruit.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "dont": [
   {
    "text": "Do not take grains on the fast day.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
  ],
