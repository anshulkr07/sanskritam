 "body": {
  "summary": "शाम के दीपों वाली कार्तिक पूर्णिमा।",
  "why": [
   {
    "text": "कार्तिक पूर्णिमा कार्तिक मास की पूर्णिमा होती है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "शाम को नदियों में दीप तैराए जाते हैं।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "सुबह स्नान और दान किया जाता है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "इसे देव दीपावली भी कहते हैं।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "दीप, फूल और मिठाई तैयार रखें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "steps": [
    {
     "text": "सुबह जल्दी स्नान करें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "स्नान के बाद दान दें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "शाम को दीप तैराएं।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "vrat": {
   "eat": [
    {
     "text": "व्रत में फल, दूध और सिंघाड़े का आटा लें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "सेंधा नमक का प्रयोग करें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "avoid": [
    {
     "text": "अनाज, दाल, चावल और सामान्य नमक से बचें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "प्याज, लहसुन और तामसिक भोजन से बचें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "break": [
    {
     "text": "अगले दिन सूर्योदय के बाद पारण समय में व्रत खोलें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "who_should_eat": [
    {
     "text": "गर्भवती, मधुमेह रोगी, दवा लेने वाले, बीमार, बच्चे और बुजुर्ग केवल फल लें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
