 "body": {
  "summary": "New moon day for rest, charity and remembrance.",
  "why": [
   {
    "text": "Amavasya is the thirtieth tithi ending the dark half.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "Families give food and charity on this day.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "The Mahalaya Amavasya closes Pitru Paksha.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "Evening lamps are lit at home.",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "Keep lamps, sesame and charity items ready.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "steps": [
    {
     "text": "Bathe in the morning and clean the home.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Offer food and charity to the needy.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Light lamps in the evening.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "vrat": {
   "eat": [
    {
     "text": "Take fruit, milk and water chestnut flour on the fast.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Use rock salt in fast cooking.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "avoid": [
    {
     "text": "Avoid grains, lentils, rice and common salt.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "Avoid onion, garlic and heavy food.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "break": [
    {
     "text": "Break the fast next morning in the parana window.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "who_should_eat": [
    {
     "text": "People who are pregnant, diabetic, on regular medicines, ill, children and the elderly take only fruit.",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "dont": [
   {
