 "body": {
  "summary": "जिस दिन कृष्ण ने गोवर्धन उठाया और उनकी महिमा गाई गई।",
  "why": [
   {
    "text": "पुलस्त्य गोवर्धन को वृंदावन लाते हैं, जहां सनंदन के शाप से वे घटते हैं।",
    "basis": "text",
    "text_name": "Garga Samhita, Vrindavana-khanda",
    "ref": "Garga 2.2",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25073&prop=wikitext&format=json"
   },
   {
    "text": "गोवर्धन की निर्मल कथा बड़े पापों को हरती है।",
    "basis": "text",
    "text_name": "Garga Samhita, Vrindavana-khanda",
    "ref": "Garga 2.2",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25073&prop=wikitext&format=json"
   },
   {
    "text": "इंद्र क्रोध में व्रज डुबोते हैं, और कृष्ण पहाड़ को एक हाथ से सात दिन उठाते हैं।",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 10.25",
    "source_url": "https://vedabase.io/en/library/sb/10/25/"
   },
   {
    "text": "इंद्र हटते हैं, कृष्ण पहाड़ रख देते हैं, और देव फूल बरसाते हैं।",
    "basis": "text",
    "text_name": "Bhagavata Purana",
    "ref": "Bhagavata 10.25",
    "source_url": "https://vedabase.io/en/library/sb/10/25/"
   },
   {
    "text": "विष्णु साधुओं की रक्षा और दुष्टों का नाश करते हैं, युग युग में।",
    "basis": "text",
    "text_name": "Bhagavad Gita",
    "ref": "Gita 4.8",
    "source_url": "shlokas row 7e54ccbca104496d"
   }
  ],
  "do": {
   "gather": [],
   "steps": [
    {
     "text": "सात दिन व्रज पर पहाड़ उठाए कृष्ण का स्मरण करें।",
     "basis": "text",
     "text_name": "Bhagavata Purana",
     "ref": "Bhagavata 10.25",
     "source_url": "https://vedabase.io/en/library/sb/10/25/"
    },
    {
     "text": "गोवर्धन को नमस्कार कर परिक्रमा करें।",
     "basis": "text",
     "text_name": "Garga Samhita, Vrindavana-khanda",
     "ref": "Garga 2.2",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25073&prop=wikitext&format=json"
    },
    {
     "text": "साधुओं की रक्षा के लिए पूजा अर्पित करें।",
     "basis": "text",
     "text_name": "Bhagavad Gita",
     "ref": "Gita 4.8",
     "source_url": "shlokas row 7e54ccbca104496d"
    }
   ],
   "budget": [
    {
     "text": "घर में उपलब्ध साफ चौकी या कपड़ा और देवता का चित्र उपयोग करें।",
     "basis": "custom",
     "region": "family",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25073&prop=wikitext&format=json"
    },
    {
     "text": "पानी, थोड़ा चावल और उपलब्ध मौसमी फल लें; महंगे उपहार आवश्यक नहीं।",
     "basis": "custom",
     "region": "family",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=25073&prop=wikitext&format=json"
    },
    {
