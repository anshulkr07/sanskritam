 "body": {
  "summary": "सूर्यास्त और सूर्योदय के दो अर्घ्य वाला पर्व।",
  "why": [
   {
    "text": "छठ कार्तिक शुक्ल षष्ठी को आता है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "सांझ का अर्घ्य सूर्यास्त पर दिया जाता है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "भोर का अर्घ्य सूर्योदय पर दिया जाता है।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   },
   {
    "text": "परिवार नदी या तालाब पर जुटते हैं।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "बांस की टोकरी, फल और ठेकुए तैयार रखें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "steps": [
    {
     "text": "दिन भर स्वच्छ रहकर व्रत रखें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "सूर्यास्त पर सांझ का अर्घ्य दें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "सूर्योदय पर भोर का अर्घ्य दें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "vrat": {
   "eat": [
    {
     "text": "व्रत में फल, दूध और सिंघाड़े का आटा लें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "सेंधा नमक का प्रयोग करें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "avoid": [
    {
     "text": "अनाज, दाल, चावल और सामान्य नमक से बचें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    },
    {
     "text": "प्याज, लहसुन और तामसिक भोजन से बचें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "break": [
    {
     "text": "अगले दिन सूर्योदय के बाद पारण समय में व्रत खोलें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ],
   "who_should_eat": [
    {
     "text": "गर्भवती, मधुमेह रोगी, दवा लेने वाले, बीमार, बच्चे और बुजुर्ग केवल फल लें।",
     "basis": "custom",
     "region": "all",
     "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
    }
   ]
  },
  "dont": [
   {
    "text": "नदी किनारा गंदा न करें।",
    "basis": "custom",
    "region": "all",
    "source_url": "https://www.drikpanchang.com/vrats/ekadashidates.html"
   }
