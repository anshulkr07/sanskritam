 "body": {
  "summary": "कार्तिक शुक्ल एकादशी, जिससे भीष्म व्रत शुरू होता है।",
  "why": [
   {
    "text": "वालखिल्य कार्तिक शुक्ल एकादशी के बारे में पूछते हैं।",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   },
   {
    "text": "एकादशी को पूर्णिमा तक चलने वाला पांच दिन का व्रत लिया जाता है।",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   },
   {
    "text": "भीष्म इसे स्नान, तर्पण, दान और दीपों के साथ रखते हैं।",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   },
   {
    "text": "पूर्णिमा को पूजा, ब्राह्मण भोजन और दान के साथ व्रत पूरा होता है।",
    "basis": "text",
    "text_name": "Skanda Purana, Kartika-mahatmya",
    "ref": "Skanda 2.12",
    "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
   }
  ],
  "do": {
   "gather": [
    {
     "text": "फूल, धूप, दीप और तर्पण के लिए जल तैयार रखें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    }
   ],
   "steps": [
    {
     "text": "सुबह स्नान कर पांच दिन का व्रत लें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    },
    {
     "text": "भीष्म को जल तर्पण दें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    },
    {
     "text": "दिन रात दीपों से विष्णु की पूजा करें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    },
    {
     "text": "पूर्णिमा को ब्राह्मणों को खिलाएं और दान दें।",
     "basis": "text",
     "text_name": "Skanda Purana, Kartika-mahatmya",
     "ref": "Skanda 2.12",
     "source_url": "https://sa.wikisource.org/w/api.php?action=parse&pageid=23011&prop=wikitext&format=json"
    }
   ],
   "budget": [
