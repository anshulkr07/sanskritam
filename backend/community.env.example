# Add to existing backend environment; never put Stream secret in EXPO_PUBLIC_*.
STREAM_API_KEY=
STREAM_API_SECRET=
# Existing R2 settings are reused. Shared chat media must use a PRIVATE bucket.
R2_PRIVATE_BUCKET=
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY and AUDIO_STORAGE=r2
# already belong to the app's normal storage configuration.
