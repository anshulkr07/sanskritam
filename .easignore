# EAS Build ignore list — prevents node_modules and other unneeded files
# from bloating the upload archive. This is at the monorepo root.

# dependencies (huge)
node_modules/

# git history
.git/

# Expo caches
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# generated native code (regenerated on EAS servers).
# Anchored to the generated dirs only: a bare `android/` also matches
# mobile/modules/shabd-digital-ink/android/ and would strip the handwriting
# module's Kotlin source from the EAS archive (Write crash, 2026-10-01).
/mobile/android/
/mobile/ios/

# keystores and signing keys
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# cloud credential JSONs (Vertex service account, Play submit key, Google
# OAuth client secrets). With an .easignore present EAS no longer reads
# .gitignore, and eas.json has requireCommit false, so untracked files in the
# working tree are uploaded unless they are named here.
vertex_credentials.json
*credentials*.json
service-account-key.json
Client IDs/

# local env files (EAS injects its own)
.env
.env*
!.env.example

# OS junk
.DS_Store
Thumbs.db

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# backend/frontend (not needed for mobile builds)
backend/
frontend/

# local artefacts that git already ignores. With an .easignore present EAS no
# longer reads .gitignore, so they must be named here too: results/ holds the
# 4K cover paintings and masters, about 1 GB. Anchored to the repo root.
/results/