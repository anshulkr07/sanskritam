# EAS Build ignore list — prevents node_modules and other unneeded files
# from bloating the upload archive. This is at the monorepo root.

# dependencies (huge)
node_modules/

# git history
.git/

# Expo caches
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# generated native code (regenerated on EAS servers)
android/
ios/

# keystores and signing keys
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# local env files (EAS injects its own)
.env
.env*
!.env.example

# OS junk
.DS_Store
Thumbs.db

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# backend/frontend (not needed for mobile builds)
backend/
frontend/