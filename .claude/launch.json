{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sanskritam-backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location backend; $env:PYTHONIOENCODING='utf-8'; ./.venv/Scripts/python.exe -m uvicorn app.main:app --port 8001 --host 0.0.0.0"
      ],
      "port": 8001
    },
    {
      "name": "sanskritam-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--prefix", "mobile"],
      "port": 8081
    }
  ]
}
