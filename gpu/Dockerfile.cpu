FROM python:3.10-slim
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY requirements-asr.txt .
RUN pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu && pip install -r requirements-asr.txt
COPY asr/ asr/
COPY config.py .
COPY models/sushrota_sanskrit_asr_v13b.nemo models/
ENV MODEL_PATH=models/sushrota_sanskrit_asr_v13b.nemo DEVICE=cpu
EXPOSE 8090
CMD ["uvicorn", "asr.server:app", "--host", "0.0.0.0", "--port", "8090"]
