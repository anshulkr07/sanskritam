FROM nvcr.io/nvidia/pytorch:24.10-py3
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY requirements-asr.txt .
RUN pip install -r requirements-asr.txt
COPY asr/ asr/
COPY config.py .
COPY models/sushrota_sanskrit_asr_v13b.nemo models/
ENV MODEL_PATH=models/sushrota_sanskrit_asr_v13b.nemo DEVICE=cuda
EXPOSE 8090
CMD ["uvicorn", "asr.server:app", "--host", "0.0.0.0", "--port", "8090"]
