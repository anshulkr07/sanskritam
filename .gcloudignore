# Source context for `gcloud run deploy --source=.` — keeps the upload small
# and avoids tarring locked build outputs. Mirrors .dockerignore.
.git
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache

# Not needed in the image
backend/.venv
backend/evals-out
backend/results
backend/*.db
backend/tests
backend/scripts
backend/app/evals/.cache
backend/app/.authoring-cache
research
specs
mobile
icons
*.md
.github
.vscode
.claude
.claude/

# vidyut-data is downloaded fresh at build time (baked into image)
backend/vidyut-data

# Render output and media the image never uses. The Dockerfile COPYs only
# backend/requirements.txt, backend/app, backend/migrations, backend/alembic.ini
# and frontend/ — nothing here. Without these, `--source=.` tars ~780 MB of
# render output (results/ 371 MB + chant_runs/ 399 MB) and the upload hangs.
results
chant_runs
gpu
gpu_jobs
storage
deploy
Claude outputs
*.rar
*.zip
*.wav
*.mp3

# Never bake secrets
.env
.env.local
.env.deploy
Client IDs/
.env.deploy.bak-*
vertex_credentials.json
*credentials*.json
service-account-key.json
