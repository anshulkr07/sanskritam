Thumbs.db
backend/vidyut-data/
backend/.venv/

# LLM eval harness
backend/app/evals/.cache/
backend/evals-out/

# Speech bench artifacts (specs/speech-bench.md — offline tools write here)
results/
# Authoring draft cache lives under app/, not backend/ directly (§repo map)
backend/app/.authoring-cache/
# Challenge-generation draft cache (P7-4) — same class of LLM-draft cache
backend/app/services/.challenge-cache/

# debug + scratch output
backend/*.txt
!backend/requirements*.txt
backend/*.json
backend/fix.py
backend/test_sarvam*.py
backend/test_eval_sarvam.py
backend/debug_empty.py

# Pre-rendered audio assets (P17-2) — generated WAVs cost grant money to make
# but are large binary build/runtime artifacts; production serves them from
# object storage (P8-2, owner-gated). Keep the DB + render script in git, not
# the audio blobs. The render pass is idempotent and re-runs for free on a
# cache-hit, so nothing is lost by ignoring them.
backend/storage/

# DB backups taken before seed/migrate/rebuild work (§2.13)
backend/app.db.bak-*

# Google OAuth client secret JSONs — never commit
Client IDs/
