{"verse_uid": "28ec8e128c8a757d", "source_ref": "Bhagavad Gītā 1.1", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "धृतराष्ट्र उवाच ।", "tts": "धृतराष्ट्र उवाच", "parts": ["धृतराष्ट्र उवाच"], "kind": "speaker", "syllables": 7}, {"i": 1, "text": "धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः ।", "tts": "धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः", "parts": ["धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः"], "kind": "verse", "syllables": 16}, {"i": 2, "text": "मामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय ॥ १ ॥", "tts": "मामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय", "parts": ["मामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "2abfcdcd7da8aa94", "source_ref": "Nītiśataka 4", "book": "Nītiśataka", "vedic": false, "lines": [{"i": 0, "text": "प्रसह्य मणिमुद्धरेन् मकरवक्त्रदंष्ट्रान्तरात् समुद्रमपि सन्तरेत्प्रचलदूर्मिमालाकुलम् | भुजङ्गमपि कोपितं शिरसि पुष्पवद्धारयेत् न तु प्रतिनिविष्टमृखजनचित्तमाराधयेत् ॥", "tts": "प्रसह्य मणिमुद्धरेन् मकरवक्त्रदंष्ट्रान्तरात् समुद्रमपि सन्तरेत्प्रचलदूर्मिमालाकुलम् भुजङ्गमपि कोपितं शिरसि पुष्पवद्धारयेत् न तु प्रतिनिविष्टमृखजनचित्तमाराधयेत्", "parts": ["प्रसह्य मणिमुद्धरेन् मकरवक्त्रदंष्ट्रान्तरात् समुद्रमपि सन्तरेत्प्रचलदूर्मिमालाकुलम्", "भुजङ्गमपि कोपितं शिरसि पुष्पवद्धारयेत् न तु प्रतिनिविष्टमृखजनचित्तमाराधयेत्"], "kind": "verse", "syllables": 68}]}
{"verse_uid": "f1c6ff91de806aa6", "source_ref": "Taittirīya Upaniṣad 1.11.1", "book": "Taittirīya Upaniṣad", "vedic": true, "lines": [{"i": 0, "text": "सत्यं वद।", "tts": "सत्यं वद", "parts": ["सत्यं वद"], "kind": "verse", "syllables": 4}, {"i": 1, "text": "धर्मं चर।", "tts": "धर्मं चर", "parts": ["धर्मं चर"], "kind": "verse", "syllables": 4}, {"i": 2, "text": "स्वाध्यायान्मा प्रमदः।", "tts": "स्वाध्यायान्मा प्रमदः", "parts": ["स्वाध्यायान्मा प्रमदः"], "kind": "verse", "syllables": 7}]}
{"verse_uid": "e1a9eca84c850936", "source_ref": "Sūkti: Subhāṣita", "book": "Sūkti: Subhāṣita", "vedic": false, "lines": [{"i": 0, "text": "परोपकारार्थमिदं शरीरम्।", "tts": "परोपकारार्थमिदं शरीरम्", "parts": ["परोपकारार्थमिदं शरीरम्"], "kind": "verse", "syllables": 11}]}
{"verse_uid": "397bd85b3d25ce74", "source_ref": "Hitopadeśa 2.47", "book": "Hitopadeśa", "vedic": false, "lines": [{"i": 0, "text": "आरोप्यते शिला शैले यत्नेन महता यथा ।", "tts": "आरोप्यते शिला शैले यत्नेन महता यथा", "parts": ["आरोप्यते शिला शैले यत्नेन महता यथा"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "निपात्यते क्षणेनाधस्तथात्मा गुणदोषयोः ॥", "tts": "निपात्यते क्षणेनाधस्तथात्मा गुणदोषयोः", "parts": ["निपात्यते क्षणेनाधस्तथात्मा गुणदोषयोः"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "ec4ef8a8452c997c", "source_ref": "Bhagavad Gītā 3.11", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "देवान्भावयतानेन ते देवा भावयन्तु वः ।", "tts": "देवान्भावयतानेन ते देवा भावयन्तु वः", "parts": ["देवान्भावयतानेन ते देवा भावयन्तु वः"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "परस्परं भावयन्तः श्रेयः परमवाप्स्यथ ॥ ११ ॥", "tts": "परस्परं भावयन्तः श्रेयः परमवाप्स्यथ", "parts": ["परस्परं भावयन्तः श्रेयः परमवाप्स्यथ"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "137709a3f4dce9bd", "source_ref": "Mahābhārata 5.33.31", "book": "Mahābhārata", "vedic": false, "lines": [{"i": 0, "text": "निश्चित्य यः प्रक्रमते नान्तर्वसति कर्मणः।", "tts": "निश्चित्य यः प्रक्रमते नान्तर्वसति कर्मणः", "parts": ["निश्चित्य यः प्रक्रमते नान्तर्वसति कर्मणः"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "अवन्ध्यकालो वश्यात्मा स वै पण्डित उच्यते ॥", "tts": "अवन्ध्यकालो वश्यात्मा स वै पण्डित उच्यते", "parts": ["अवन्ध्यकालो वश्यात्मा स वै पण्डित उच्यते"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "85b0e61cc64c2111", "source_ref": "Bhagavad Gītā 2.71", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "विहाय कामान्यः सर्वान्पुमांश्चरति निःस्पृहः ।", "tts": "विहाय कामान्यः सर्वान्पुमांश्चरति निःस्पृहः", "parts": ["विहाय कामान्यः सर्वान्पुमांश्चरति निःस्पृहः"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "निर्ममो निरहङ्कारः स शान्तिमधिगच्छति ॥ ७१ ॥", "tts": "निर्ममो निरहङ्कारः स शान्तिमधिगच्छति", "parts": ["निर्ममो निरहङ्कारः स शान्तिमधिगच्छति"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "edaace3ff1ba4f21", "source_ref": "Mahābhārata 5.34.32", "book": "Mahābhārata", "vedic": false, "lines": [{"i": 0, "text": "धर्मेण राज्यं विन्देत धर्मेण परिपालयेत्।", "tts": "धर्मेण राज्यं विन्देत धर्मेण परिपालयेत्", "parts": ["धर्मेण राज्यं विन्देत धर्मेण परिपालयेत्"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "धर्ममूलां श्रियं प्राप्य न जहाति न हीयते । ।", "tts": "धर्ममूलां श्रियं प्राप्य न जहाति न हीयते", "parts": ["धर्ममूलां श्रियं प्राप्य न जहाति न हीयते"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "ad2a4b9f3aab7762", "source_ref": "Hitopadeśa 2.8", "book": "Hitopadeśa", "vedic": false, "lines": [{"i": 0, "text": "अलब्धं चैव लिप्सेत लब्धं रक्षेत् अवेक्षया ।", "tts": "अलब्धं चैव लिप्सेत लब्धं रक्षेत् अवेक्षया", "parts": ["अलब्धं चैव लिप्सेत लब्धं रक्षेत् अवेक्षया"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "रक्षितं वर्धयेत्सम्यग्वृद्धं तीर्येषु निक्षिपेत् ॥", "tts": "रक्षितं वर्धयेत्सम्यग्वृद्धं तीर्येषु निक्षिपेत्", "parts": ["रक्षितं वर्धयेत्सम्यग्वृद्धं तीर्येषु निक्षिपेत्"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "2b1bdd652fd8e53b", "source_ref": "Hitopadeśa 2.67", "book": "Hitopadeśa", "vedic": false, "lines": [{"i": 0, "text": "मणिर्लुठति पादेषु काचः शिरसि धार्यते ।", "tts": "मणिर्लुठति पादेषु काचः शिरसि धार्यते", "parts": ["मणिर्लुठति पादेषु काचः शिरसि धार्यते"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "यथैवास्ते तथैवास्तां काचः काचौ मणिर्मणिः ॥", "tts": "यथैवास्ते तथैवास्तां काचः काचौ मणिर्मणिः", "parts": ["यथैवास्ते तथैवास्तां काचः काचौ मणिर्मणिः"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "155a0e655e266fee", "source_ref": "Bhagavad Gītā 5.20", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम् ।", "tts": "न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम्", "parts": ["न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम्"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "स्थिरबुद्धिरसम्मूढो ब्रह्मविद्ब्रह्मणि स्थितः ॥ २० ॥", "tts": "स्थिरबुद्धिरसम्मूढो ब्रह्मविद्ब्रह्मणि स्थितः", "parts": ["स्थिरबुद्धिरसम्मूढो ब्रह्मविद्ब्रह्मणि स्थितः"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "3c29be0480884959", "source_ref": "Kaṭhopaniṣad 1.2.1", "book": "Kaṭhopaniṣad", "vedic": true, "lines": [{"i": 0, "text": "अन्यच्छ्रेयो ऽन्यदुतैव प्रेयस्ते उभे नानार्थे पुरुषं सिनीतः ।", "tts": "अन्यच्छ्रेयो ऽन्यदुतैव प्रेयस्ते उभे नानार्थे पुरुषं सिनीतः", "parts": ["अन्यच्छ्रेयो ऽन्यदुतैव प्रेयस्ते उभे नानार्थे पुरुषं सिनीतः"], "kind": "verse", "syllables": 22}, {"i": 1, "text": "तयोः श्रेय आददानस्य साधु भवति हीयते ऽर्थाद्य उ प्रेयो वृणीते ॥", "tts": "तयोः श्रेय आददानस्य साधु भवति हीयते ऽर्थाद्य उ प्रेयो वृणीते", "parts": ["तयोः श्रेय आददानस्य साधु भवति हीयते ऽर्थाद्य उ प्रेयो वृणीते"], "kind": "verse", "syllables": 25}]}
{"verse_uid": "52daee33e3801a77", "source_ref": "Bhagavad Gītā 5.24", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः ।", "tts": "योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः", "parts": ["योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "स योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति ॥ २४ ॥", "tts": "स योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति", "parts": ["स योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "8b45088c0dbb2a9b", "source_ref": "Rāmāyaṇa 1.1.14", "book": "Rāmāyaṇa", "vedic": false, "lines": [{"i": 0, "text": "रक्षिता स्वस्य धर्मस्य स्वजनस्य च रक्षिता ।", "tts": "रक्षिता स्वस्य धर्मस्य स्वजनस्य च रक्षिता", "parts": ["रक्षिता स्वस्य धर्मस्य स्वजनस्य च रक्षिता"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "वेदवेदाङ्गतत्त्वज्ञो धनुर्वेदे च निष्ठितः ॥", "tts": "वेदवेदाङ्गतत्त्वज्ञो धनुर्वेदे च निष्ठितः", "parts": ["वेदवेदाङ्गतत्त्वज्ञो धनुर्वेदे च निष्ठितः"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "c07202637dda6d97", "source_ref": "Bhagavad Gītā 18.34", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "यया तु धर्मकामार्थान्धृत्या धारयतेऽर्जुन ।", "tts": "यया तु धर्मकामार्थान्धृत्या धारयतेऽर्जुन", "parts": ["यया तु धर्मकामार्थान्धृत्या धारयतेऽर्जुन"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "प्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी ॥ ३४ ॥", "tts": "प्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी", "parts": ["प्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "bad208cf1ee1be74", "source_ref": "Mahābhārata 5.33.69", "book": "Mahābhārata", "vedic": false, "lines": [{"i": 0, "text": "त्रयो न्याया मनुष्याणां श्रूयन्ते भरतर्षभ ।", "tts": "त्रयो न्याया मनुष्याणां श्रूयन्ते भरतर्षभ", "parts": ["त्रयो न्याया मनुष्याणां श्रूयन्ते भरतर्षभ"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "कनीयान्मध्यमः श्रेष्ठ इति वेदविदो विदुः । ।", "tts": "कनीयान्मध्यमः श्रेष्ठ इति वेदविदो विदुः", "parts": ["कनीयान्मध्यमः श्रेष्ठ इति वेदविदो विदुः"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "35b1af23857d9954", "source_ref": "Bhagavad Gītā 12.13", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च।", "tts": "अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च", "parts": ["अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "निर्ममो निरहङ्कारः समदुःखसुखः क्षमी॥", "tts": "निर्ममो निरहङ्कारः समदुःखसुखः क्षमी", "parts": ["निर्ममो निरहङ्कारः समदुःखसुखः क्षमी"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "b27ce274853ee12c", "source_ref": "Mahābhārata 5.34.52", "book": "Mahābhārata", "vedic": false, "lines": [{"i": 0, "text": "प्रायेण श्रीमतां लोके भोक्तुं शक्तिर्न विद्यते।", "tts": "प्रायेण श्रीमतां लोके भोक्तुं शक्तिर्न विद्यते", "parts": ["प्रायेण श्रीमतां लोके भोक्तुं शक्तिर्न विद्यते"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "जीर्यन्त्यपि हि काष्ठानि दरिद्राणां महीपते । ।", "tts": "जीर्यन्त्यपि हि काष्ठानि दरिद्राणां महीपते", "parts": ["जीर्यन्त्यपि हि काष्ठानि दरिद्राणां महीपते"], "kind": "verse", "syllables": 16}]}
{"verse_uid": "d7700f02eaf92fd0", "source_ref": "Bhagavad Gītā 1.43", "book": "Bhagavad Gītā", "vedic": false, "lines": [{"i": 0, "text": "दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः ।", "tts": "दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः", "parts": ["दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः"], "kind": "verse", "syllables": 16}, {"i": 1, "text": "उत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः ॥ ४३ ॥", "tts": "उत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः", "parts": ["उत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः"], "kind": "verse", "syllables": 16}]}
