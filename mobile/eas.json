{
  "cli": {
    "version": ">= 14.0.0",
    "requireCommit": false,
    "appVersionSource": "local"
  },
  "build": {
    "ads-test": {
      "extends": "preview",
      "channel": "ads-test",
      "env": {
        "EXPO_PUBLIC_HYBRID_COMMERCE": "true",
        "EXPO_PUBLIC_ADS_MODE": "test"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "android-internal": {
      "extends": "production",
      "environment": "production",
      "distribution": "store",
      "channel": "android-internal"
    },
    "ios-testflight": {
      "extends": "production",
      "environment": "production",
      "distribution": "store",
      "channel": "ios-testflight",
      "ios": {
        "autoIncrement": "buildNumber"
      }
    },
    "production-apk": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SHBAD_RELEASE_URL": "https://shabd-api-829757572630.asia-south1.run.app",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "829757572630-fburmj96vtc13snqnnt08rtu1jfdbbmn.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": "829757572630-63unmold7f790tfkhpns7rlkfqfupjgk.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB": "829757572630-4671983larm19abnu5qtopbbs6ehnbqp.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account-key.json",
        "track": "production"
      }
    }
  }
}
