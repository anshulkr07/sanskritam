{
  "expo": {
    "name": "Sanskritam",
    "slug": "sanskritam",
    "version": "1.7.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ffc34e8f-6a3e-4c79-a3ef-d49791074530"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sanskritam",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanskritam.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sanskritam.app",
      "versionCode": 12,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFF6ED",
          "resizeMode": "contain",
          "imageWidth": 320,
          "android": {
            "image": "./assets/splash-icon-android.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sanskritam uses your place to work out today's tithi and festival dates"
        }
      ],
      "expo-font",
      "./plugins/withVoiceEchoCancellation",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-file-system",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sanskritam to photograph handwriting for recognition by Sarvam AI. Optional eyes-closed recitation checks run only on this phone.",
          "microphonePermission": "Allow Sanskritam to hear your recitation so it can be scored."
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.829757572630-63unmold7f790tfkhpns7rlkfqfupjgk"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an optional profile picture for your Sanskritam account."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ffc34e8f-6a3e-4c79-a3ef-d49791074530"
      }
    },
    "owner": "sanskritam"
  }
}
