# Mobile build-time environment (Expo). Copy to .env and set values.
# These are inlined at bundle/build time — they never touch the filesystem DB.

# Deployed backend for RELEASE builds (U9-3 / P18-3). A release build with an
# unset URL fails loudly at startup (HANDOVER §2.11); it must never fall back
# to localhost. The deploy script (deploy/gcp/deploy.sh) prints this URL after
# a deploy — it looks like: https://shabd-api-<deployment-hash>-as.a.run.app
EXPO_PUBLIC_SHBAD_RELEASE_URL=

# Google Sign-in client IDs (Sign in with Google). From the Google Cloud
# Console for project gen-lang-client-0232760726:  APIs & Services →
# Credentials → Create credentials → OAuth client ID.
#   - Android client ID (package com.sanskritam.app + release keystore SHA-1)
#   - iOS client ID (bundle com.sanskritam.app) if you ship iOS
#   - Web application client ID (for the auth-session redirect / Expo web)
# The client's ID token carries aud == that same client ID, which is what the
# backend POST /auth/google verifies — so set the SAME values here and in the
# backend deploy secret GOOGLE_CLIENT_ID (comma-separated). Empty IDs disable
# the corresponding Google button; Continue as Guest always works.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# The Shop (purchases) is its own switch; ads no longer need it.
EXPO_PUBLIC_HYBRID_COMMERCE=false
# Ads need a new native binary. Default off. test = Google demo ads.
# live = your units; its runtime is "<version>-ads-live-v1", so OTA updates
# for that build must be published with the same ad variables set.
EXPO_PUBLIC_ADS_MODE=off
# Live builds: the platform being built needs its app ID and native unit
# (EAS_BUILD_PLATFORM picks it; with none set, Android). Interstitial units
# (the audiobook player's full-screen ads) are optional: without one the player
# shows none. Rewarded units wait until paid editions are on sale
# (specs/ads-20261105.md).
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE=
EXPO_PUBLIC_ADMOB_IOS_NATIVE=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
